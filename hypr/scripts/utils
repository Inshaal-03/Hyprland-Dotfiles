#!/usr/bin/env bash
terminal=alacritty
utils=(Nmtui,Bluetui,Wiremix,Btop,Nvtop,Yazi,Clipse,Disk-Usage)

util=$(echo "${utils[*]}" | rofi -theme-str "window {width: 550px; height:280px;}" -dmenu -i -sep "," -p "Select which utility you want to open" -l "${#utils[*]}") # "${#utils[*]}" this gives us the length of an array

case "$util" in
  Nmtui)
    $terminal --class "utils" -e env NEWT_COLORS='root=white,black;window=white,black;border=white,black;shadow=black,black;title=red,black;label=cyan,black;listbox=white,black;actlistbox=white,red;button=red,black;' nmtui
    ;;
  Bluetui)
    $terminal --class "utils" -e bluetui
    ;;
  Wiremix)
    $terminal --class "utils" -e wiremix
    ;;
  Btop)
    $terminal --class "utils" -e btop
    ;;
  Nvtop)
    $terminal --class "utils" -e nvtop
    ;;
  Yazi)
    wezterm start --class "utils" -e yazi
    ;;
  Clipse)
   $terminal --class "utils" -e clipse
    ;;
  Disk-Usage)
    $terminal --class "utils" -e dua i
    ;;
  *)
    exit 0
esac
